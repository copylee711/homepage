FROM node:24.21.0-bookworm-slim
# Optional apt tweaks for hosts with a slow or broken route to deb.debian.org.
# Defaults leave the base image's apt setup untouched.
#   APT_MIRROR=mirrors.aliyun.com  replaces deb.debian.org in the apt sources
#   APT_FORCE_IPV4=1               writes Acquire::ForceIPv4 "true" for apt
# Both persist in this image, so images built FROM it (sandbox, egress) inherit them.
ARG APT_MIRROR=
ARG APT_FORCE_IPV4=0
RUN if [ "$APT_FORCE_IPV4" = 1 ]; then echo 'Acquire::ForceIPv4 "true";' > /etc/apt/apt.conf.d/99force-ipv4; fi \
    && if [ -n "$APT_MIRROR" ]; then \
         for f in /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list; do \
           if [ -f "$f" ]; then sed -i "s|deb.debian.org|$APT_MIRROR|g" "$f"; fi; \
         done; \
       fi \
    && apt-get update && apt-get install -y --no-install-recommends ca-certificates git python3 ripgrep curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/pi
COPY agent-platform/package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
ENV PATH="/opt/pi/node_modules/.bin:$PATH" PI_CODING_AGENT_DIR=/data/agent HOME=/data
WORKDIR /app
COPY agent-platform/runner.mjs agent-platform/shared.mjs agent-platform/turn-stream.mjs agent-platform/prompt-input.mjs ./
COPY agent-platform/providers.mjs agent-platform/provider-test.mjs agent-platform/provider-models.mjs ./
COPY agent-platform/sandbox-client.mjs agent-platform/session-limits.mjs agent-platform/session-cwd.mjs ./
COPY agent-platform/conversations.mjs agent-platform/workspace.mjs ./
COPY agent-platform/session-snapshot.mjs agent-platform/turn-watchdog.mjs ./
COPY agent-platform/tool-approvals.mjs agent-platform/source-wiki.mjs ./
COPY agent-platform/execution-policy.mjs agent-platform/search.mjs agent-platform/memory.mjs ./
COPY agent-platform/features.mjs agent-platform/mcp.mjs agent-platform/stream-wire.mjs agent-platform/web-session.mjs ./
COPY agent-platform/execution-policy.mjs agent-platform/agent-guidance.mjs agent-platform/figure-catalog.mjs /opt/pi/
COPY agent-platform/packages.mjs agent-platform/usage.mjs agent-platform/zip.mjs ./
COPY agent-platform/toolchains.mjs agent-platform/toolchains.json agent-platform/search-presets.json ./
COPY agent-platform/sandbox-extension.ts /opt/pi/sandbox-extension.ts
COPY agent-platform/package-resources.mjs agent-platform/install-background.mjs /opt/pi/
COPY openwiki/iris-figures/ /opt/openwiki/iris-figures/
USER 1000:1000
CMD ["node", "runner.mjs"]
