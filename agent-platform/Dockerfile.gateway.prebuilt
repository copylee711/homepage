# Gateway runtime from Dockerfile.gateway stage 2, reusing a web/dist that was
# already built from the same commit (npm run build in agent-platform/web).
# The repo-root .dockerignore excludes web/dist, so build this from a context
# that holds only agent-platform/{runtime .mjs, web/dist}; scripts/deploy-images.sh
# assembles that context. Keep the COPY list in sync with Dockerfile.gateway.
FROM node:24.21.0-bookworm-slim
WORKDIR /app
COPY agent-platform/gateway.mjs agent-platform/shared.mjs agent-platform/widget-document.mjs agent-platform/cloud-turns.mjs agent-platform/turn-stream.mjs agent-platform/prompt-input.mjs ./
COPY agent-platform/web/dist ./web/dist
USER 1000:1000
CMD ["node", "gateway.mjs"]
