# /etc/copylee-agent-sandbox.env, root 0600; same secret as Compose SANDBOX_SECRET.
SANDBOX_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_64_CHAR_SECRET
SANDBOX_IMAGE=copylee-agent-sandbox:latest
SANDBOX_ROOT=/var/lib/copylee-sandboxes
SANDBOX_NETWORK=copylee-agent-tools
# Optional fixed host proxy for web_fetch; never passed to tool containers.
# SANDBOX_WEB_PROXY=192.168.84.1:17892
SANDBOX_TOTAL_DISK_MIB=8192
SANDBOX_ACTIVE_MEMORY_MIB=4096
