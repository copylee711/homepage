PUBLIC_URL=https://ai.copylee.cn
SANDBOX_SECRET=REPLACE_WITH_INDEPENDENT_RANDOM_64_CHAR_SECRET
HOMEPAGE_URL=https://copylee.cn
HOMEPAGE_CLIENT_SECRET=replace-with-a-random-secret-at-least-32-characters
RUNNER_SECRET=replace-with-a-different-random-secret-at-least-32-characters
OPENCODE_GO_API_KEY=replace-with-your-opencode-go-key
PI_MODEL=opencode-go/deepseek-v4.1-flash
# Optional trusted egress proxy. Destination ACLs still apply to pinned public IPs.
# SANDBOX_EGRESS_PROXY=192.168.84.1:17892
# Optional apt tweaks for image builds (compose build / scripts/deploy-images.sh).
# Leave unset to use deb.debian.org; xa sets both because its IPv6 route to debian.org hangs.
# APT_MIRROR=mirrors.aliyun.com
# APT_FORCE_IPV4=1
