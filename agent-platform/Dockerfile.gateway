# Stage 1: build the Vite SPA (web/dist).
FROM node:24.21.0-bookworm-slim AS web
WORKDIR /web
COPY agent-platform/web/package.json agent-platform/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY agent-platform/web/ ./
# web/dev/mock-plugin.mjs imports these as ../../ from /web/dev, i.e. the image
# root. Production `vite build` does not load the mock; keep the modules here
# so a config bundle can still resolve them.
COPY agent-platform/widget-document.mjs \
     agent-platform/features.mjs \
     agent-platform/search.mjs \
     agent-platform/shared.mjs \
     agent-platform/search-presets.json \
     /
RUN npm run build

# Stage 2: the gateway runtime, serving the built SPA.
FROM node:24.21.0-bookworm-slim
WORKDIR /app
COPY agent-platform/gateway.mjs agent-platform/shared.mjs agent-platform/widget-document.mjs agent-platform/cloud-turns.mjs agent-platform/turn-stream.mjs ./
COPY --from=web /web/dist ./web/dist
USER 1000:1000
CMD ["node", "gateway.mjs"]
