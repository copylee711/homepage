# Copy Lee 私有云品牌与合规信息（安装到 /etc/sftpgo/env.d/branding.env）。
# 路径相对 SFTPGo 的 static_files_path（/usr/share/sftpgo/static）。
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__NAME="Copy Lee Cloud"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__SHORT_NAME="私有云盘"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__LOGO_PATH="/branding/logo.svg"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__FAVICON_PATH="/branding/favicon.svg"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__DISCLAIMER_NAME="粤ICP备2026159168号"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__DISCLAIMER_PATH="https://beian.miit.gov.cn/"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_CLIENT__EXTRA_CSS="/branding/copylee.css"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__NAME="Copy Lee Cloud Admin"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__SHORT_NAME="管理后台"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__LOGO_PATH="/branding/logo.svg"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__FAVICON_PATH="/branding/favicon.svg"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__DISCLAIMER_NAME="粤ICP备2026159168号"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__DISCLAIMER_PATH="https://beian.miit.gov.cn/"
SFTPGO_HTTPD__BINDINGS__0__BRANDING__WEB_ADMIN__EXTRA_CSS="/branding/copylee.css"
