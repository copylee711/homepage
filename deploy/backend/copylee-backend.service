[Unit]
Description=Copy Lee content backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=copylee
Group=copylee
WorkingDirectory=/opt/copylee-backend/current
EnvironmentFile=/etc/copylee/backend.env
ExecStart=/opt/copylee-backend/current/.venv/bin/uvicorn app.asgi:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=copylee
StateDirectoryMode=0711
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/copylee

[Install]
WantedBy=multi-user.target
