# 安装到 /etc/copylee/backend.env，权限 0600。
COPYLEE_DATA_DIR=/var/lib/copylee
COPYLEE_STATIC_DIR=/var/www/copylee
COPYLEE_SITE_URL=http://copylee.cn
COPYLEE_ALLOWED_ORIGINS=http://localhost:8000
COPYLEE_PUBLIC_ADMIN=false
COPYLEE_SECURE_COOKIE=false
COPYLEE_SYNC_ENABLED=true
COPYLEE_SCUT_SYNC_ENABLED=true
COPYLEE_SESSION_HOURS=12
COPYLEE_LOG_DIR=/var/log/copylee
# 图床公开地址（Caddy 中 image.copylee.cn 站点直接提供 /var/lib/copylee/images）。
COPYLEE_IMAGE_URL=https://image.copylee.cn
COPYLEE_GITHUB_TOKEN=
# 仅控制前端 SDK；回源密钥保存在 /etc/caddy/email-code-origin.caddy，禁止提交 Git。
COPYLEE_EMAIL_CAPTCHA_ENABLED=false
COPYLEE_EMAIL_CAPTCHA_PREFIX=esa-rwe96uub0q
COPYLEE_EMAIL_CAPTCHA_SCENE_ID=trwiyf09
# HTTPS 就绪后 SITE_URL 改为 https://copylee.cn，加入同域 Origin，
# PUBLIC_ADMIN 和 SECURE_COOKIE 同时改为 true。
# —— 网盘（替代 SFTPGo）——
# 网盘网页与分享链接；WebDAV 与 SFTP 地址只用于页面上的配置说明。
COPYLEE_DRIVE_URL=https://cloud.copylee.cn
COPYLEE_DAV_URL=https://dav.copylee.cn
COPYLEE_SFTP_HOST=cloud.copylee.cn
COPYLEE_SFTP_PORT=2022
COPYLEE_SFTP_LISTEN=0.0.0.0:2022
COPYLEE_DAV_LISTEN=127.0.0.1:10080
# 主站与 cloud 子域名共用登录；ALLOWED_ORIGINS 需同时包含 https://cloud.copylee.cn。
COPYLEE_COOKIE_DOMAIN=copylee.cn
# OSS 挂载点：RAM 子账号仅授权网盘 bucket，走内网 endpoint。
COPYLEE_OSS_ACCESS_KEY_ID=
COPYLEE_OSS_ACCESS_KEY_SECRET=
COPYLEE_OSS_BUCKET=copylee-cloud
COPYLEE_OSS_REGION=cn-guangzhou
COPYLEE_OSS_ENDPOINT=oss-cn-guangzhou-internal.aliyuncs.com
