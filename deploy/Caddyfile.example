# 备案完成后的 HTTPS 配置（需安全组放行 443）。HTTP 阶段使用 Caddyfile.http.example。
www.copylee.cn {
    redir https://copylee.cn{uri} permanent
}
copylee.cn {
    encode zstd gzip
    @backend path /api /api/* /posts /posts/* /notes /notes/* /sitemap.xml /feed.xml /robots.txt /content-assets/*
    handle @backend {
        reverse_proxy 127.0.0.1:8000
    }
    handle_path /media/* {
        root * /var/lib/copylee/media
        header Cache-Control "public, max-age=31536000, immutable"
        header X-Content-Type-Options nosniff
        file_server
    }
    @admin path /admin /admin/*
    handle @admin {
        root * /var/www/copylee
        header Cache-Control no-store
        header X-Robots-Tag noindex
        try_files /index.html
        file_server
    }
    handle /assets/* {
        root * /var/www/copylee
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    @scut path /scut /scut/
    handle @scut {
        root * /var/www/copylee
        header Cache-Control no-cache
        rewrite * /index.html
        file_server
    }
    handle {
        root * /var/www/copylee
        header Cache-Control no-cache
        file_server
    }
    # 未匹配的页面由后端渲染与站点一致的 404 页面。
    handle_errors 404 {
        rewrite * /404
        reverse_proxy 127.0.0.1:8000
    }
}
# 子域名需要先在 DNS 添加 cloud、dav 的 A 记录，否则证书签发失败；未添加前保留 http:// 前缀。
cloud.copylee.cn {
    reverse_proxy 127.0.0.1:8080
}
dav.copylee.cn {
    reverse_proxy 127.0.0.1:10080
}
