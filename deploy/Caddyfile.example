# 备案完成后的 HTTPS 配置（需安全组放行 443）。HTTP 阶段使用 Caddyfile.http.example。

# 访问日志：JSON 格式，按 50MiB 滚动并 gzip 压缩，保留 190 天（网络日志留存不少于六个月）。
# Cookie、Authorization 等敏感请求头由 Caddy 默认脱敏。
(access_log) {
    log {
        output file /var/log/caddy/{args[0]}.log {
            roll_size 50MiB
            roll_keep 2000
            roll_keep_for 4560h
        }
        format filter {
            wrap json
            request>headers>X-Copylee-Esa-Origin delete
            request>headers>Captcha-Verify-Param delete
        }
    }
}
www.copylee.cn {
    import access_log copylee
    # 由 ESA 提供边缘证书；源站证书仅用于 ESA 回源加密，ESA 的 ACME 校验无法回源。
    tls internal
    redir https://copylee.cn{uri} permanent
}
copylee.cn {
    import access_log copylee
    # 由 ESA 提供边缘证书；源站证书仅用于 ESA 回源加密，ESA 的 ACME 校验无法回源。
    tls internal
    encode zstd gzip
    @backend path /api /api/* /posts /posts/* /notes /notes/* /privacy /sitemap.xml /feed.xml /robots.txt /content-assets/*
    handle @backend {
        route {
            # 必须先校验回源身份，再代理；文件安装见 deploy/README.md。
            # 发送邮箱验证码与提交反馈：只放行经 ESA AI 验证码后回源的请求。
            @esa_guarded {
                path /api/account/code /api/account/code/ /api/account/feedback
                method POST
            }
            route @esa_guarded {
                import /etc/caddy/email-code-origin.caddy
            }
            reverse_proxy 127.0.0.1:8000 {
                header_up -X-Copylee-Esa-Origin
                header_up -Captcha-Verify-Param
            }
        }
    }
    handle_path /media/* {
        root * /var/lib/copylee/media
        header Cache-Control "public, max-age=31536000, immutable"
        header X-Content-Type-Options nosniff
        file_server
    }
    @admin path /admin /admin/*
    handle @admin {
        root * /var/www/copylee
        header Cache-Control no-store
        header X-Robots-Tag noindex
        try_files /index.html
        file_server
    }
    handle /assets/* {
        root * /var/www/copylee
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    # 协作文档的编辑页需要 WebSocket，ESA 免费版不支持；团队工作区要上传大文件。统一跳到直连源站的云盘子域名。
    @docpage path /doc/* /d/* /t/*
    redir @docpage https://cloud.copylee.cn{uri} 302
    @scut path /scut /scut/ /account /games /games/* /docs /docs/ /teams /teams/
    handle @scut {
        root * /var/www/copylee
        header Cache-Control no-cache
        rewrite * /index.html
        file_server
    }
    handle {
        root * /var/www/copylee
        header Cache-Control no-cache
        file_server
    }
    # 未匹配的页面由后端渲染与站点一致的 404 页面。
    handle_errors 404 {
        rewrite * /404
        reverse_proxy 127.0.0.1:8000
    }
}
image.copylee.cn {
    import access_log image
    # 由 ESA 提供边缘证书；源站证书仅用于 ESA 回源加密，ESA 的 ACME 校验无法回源。
    tls internal
    # 图床：静态图片直接由 Caddy 提供，仅上传接口转发到后端；前置 ESA 时上传路径需设为不缓存。
    @upload path /api/upload
    handle @upload {
        reverse_proxy 127.0.0.1:8000
    }
    @image path_regexp ^/\d{4}/\d{2}/[A-Za-z0-9]{12}\.(jpg|png|webp|gif)$
    handle @image {
        root * /var/lib/copylee/images
        header Cache-Control "public, max-age=31536000, immutable"
        header X-Content-Type-Options nosniff
        header Access-Control-Allow-Origin *
        file_server
    }
    handle {
        redir https://copylee.cn 302
    }
}
cloud.copylee.cn {
    import access_log cloud
    encode zstd gzip
    # 云盘：前端与主站共用同一份构建，接口转发到后端；不经过 ESA，大文件上传不受 CDN 限制。
    # 发验证码与提交反馈只能经 ESA（带 AI 验证码）在主站完成。
    @esa_only {
        path /api/account/code /api/account/code/ /api/account/feedback
        method POST
    }
    handle @esa_only {
        respond "请在 copylee.cn 上完成此操作" 403
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }
    handle /media/avatars/* {
        root * /var/lib/copylee
        file_server
    }
    handle /assets/* {
        root * /var/www/copylee
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /var/www/copylee
        header Cache-Control no-cache
        try_files {path} /index.html
        file_server
    }
}
dav.copylee.cn {
    import access_log dav
    # 仅浏览器直接打开根路径时显示说明页；WebDAV 客户端使用 PROPFIND 或带认证请求，不受影响
    @browser {
        method GET HEAD
        path /
        header Accept *text/html*
        not header Authorization *
    }
    handle @browser {
        root * /var/www/dav-landing
        rewrite * /dav.html
        header Cache-Control no-cache
        file_server
    }
    handle {
        reverse_proxy 127.0.0.1:10080
    }
}
