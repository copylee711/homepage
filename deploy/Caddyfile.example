# HTTPS 就绪后的配置。当前 HTTP 阶段使用 Caddyfile.http.example。
www.copylee.cn {
    redir https://copylee.cn{uri} permanent
}
copylee.cn {
    encode zstd gzip
    @backend path /api /api/* /posts /posts/* /sitemap.xml /robots.txt /content-assets/*
    handle @backend {
        reverse_proxy 127.0.0.1:8000
    }
    handle_path /media/* {
        root * /var/lib/copylee/media
        header Cache-Control "public, max-age=31536000, immutable"
        header X-Content-Type-Options nosniff
        file_server
    }
    @admin path /admin /admin/*
    handle @admin {
        root * /var/www/copylee
        header Cache-Control no-store
        header X-Robots-Tag noindex
        try_files /index.html
        file_server
    }
    handle /assets/* {
        root * /var/www/copylee
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /var/www/copylee
        header Cache-Control no-cache
        file_server
    }
}
http://cloud.copylee.cn {
    reverse_proxy 127.0.0.1:8080
}
http://dav.copylee.cn {
    reverse_proxy 127.0.0.1:10080
}
