# gz 当前 HTTP 阶段，管理通过 SSH 隧道直连后端。
http://copylee.cn, http://www.copylee.cn {
    encode zstd gzip
    @private path /admin /admin/* /api/auth /api/auth/* /api/admin /api/admin/*
    handle @private {
        respond "管理后台请通过 SSH 隧道访问" 403
    }
    @backend path /api /api/* /posts /posts/* /notes /notes/* /privacy /sitemap.xml /feed.xml /robots.txt /content-assets/*
    handle @backend {
        reverse_proxy 127.0.0.1:8000
    }
    handle_path /media/* {
        root * /var/lib/copylee/media
        header Cache-Control "public, max-age=31536000, immutable"
        header X-Content-Type-Options nosniff
        file_server
    }
    handle /assets/* {
        root * /var/www/copylee
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    @scut path /scut /scut/ /account /games /games/*
    handle @scut {
        root * /var/www/copylee
        header Cache-Control no-cache
        rewrite * /index.html
        file_server
    }
    handle {
        root * /var/www/copylee
        header Cache-Control no-cache
        file_server
    }
    # 未匹配的页面由后端渲染与站点一致的 404 页面。
    handle_errors 404 {
        rewrite * /404
        reverse_proxy 127.0.0.1:8000
    }
}
http://cloud.copylee.cn {
    reverse_proxy 127.0.0.1:8080
}
http://dav.copylee.cn {
    reverse_proxy 127.0.0.1:10080
}
