# 安装到 /etc/sftpgo/sftpgo.env（systemd 的 EnvironmentFile，会覆盖单元里的空 SFTPGO_LOG_FILE_PATH）。
# 日志写入文件，按 50MB 滚动并压缩，保留 190 天（网络日志留存不少于六个月）；MAX_BACKUPS=0 表示不按数量删除。
SFTPGO_LOG_FILE_PATH=/var/log/sftpgo/sftpgo.log
SFTPGO_LOG_MAX_SIZE=50
SFTPGO_LOG_MAX_BACKUPS=0
SFTPGO_LOG_MAX_AGE=190
SFTPGO_LOG_COMPRESS=true
